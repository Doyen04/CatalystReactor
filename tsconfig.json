{
    "compilerOptions": {
        "noEmit": true,
        "strict": true,
        "baseUrl": ".",
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "module": "preserve",
        "target": "ESNext",
        "jsx": "react-jsx",
        "paths": {
            "@assets/*": [
                "src/assets/*"
            ],
            "@component/*": [
                "src/component/*"
            ],
            "@hooks/*": [
                "src/hooks/*"
            ],
            "@lib/*": [
                "src/lib/*"
            ],
            "@types/*": [
                "src/types/*"
            ],
            "@ui/*": [
                "src/ui/*"
            ],
            "@/*": [
                "src/*"
            ],
            "@util/*": [
                "src/util/*"
            ],
            "@helper/*": [
                "src/lib/helper/*"
            ],
            "@data/*": [
                "src/data/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ],
            "@node/*": [
                "src/lib/node/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "to-be-deleted"
    ]
}